# ============================================================
# Capiva Cloud — variáveis do docker-compose.deploy.yml
# Copie para .env no host de deploy e gere segredos próprios:
#   openssl rand -hex 16   # senhas
#   openssl rand -hex 32   # ENCRYPTION_KEY
# ============================================================

# Host/IP pelo qual o painel é acessado (usado no WebSocket do terminal web).
PUBLIC_HOST=10.1.2.8

# Portas publicadas no host.
PANEL_PORT=8410
API_PORT=8411

# Postgres dedicado ao control plane (sem porta publicada).
POSTGRES_PASSWORD=troque-me

# Cifragem de credenciais em repouso (AES-256-GCM, 32 bytes hex).
# O backend RECUSA subir em produção com o valor de exemplo.
ENCRYPTION_KEY=troque-me-32-bytes-hex

# Par RSA que assina os access tokens. Obrigatório em produção — sem ele cada
# réplica geraria a própria chave e um rollout invalidaria todas as sessões.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -in jwt.key -pubout -out jwt.pub
# Cole o PEM com \n literais, ou use JWT_PRIVATE_KEY_FILE/JWT_PUBLIC_KEY_FILE
# apontando para um secret montado em volume.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Marque o cookie de refresh como Secure quando o painel estiver atrás de HTTPS.
COOKIE_SECURE=false

# Aceita certificado self-signed APENAS nas chamadas ao API server do Kubernetes
# (k3s/on-prem sem CA no kubeconfig). Não afeta Git, S3, webhooks e notificações.
CAPIVA_K8S_INSECURE_TLS=false

# Origens extras liberadas no CORS (separadas por vírgula). No deploy padrão o
# nginx serve painel e API na mesma origem, então pode ficar vazio.
ORIGIN_WHITELIST=

# MinIO dedicado (backups/uploads, sem porta publicada).
MINIO_ROOT_USER=capiva
MINIO_ROOT_PASSWORD=troque-me

# E-mail da CapivApp (canal de notificação "E-mail da CapivApp", via mail-send).
# Sem o token o canal fica indisponível: o teste do canal mostra o erro.
MAIL_SEND_URL=https://mail.capivapp.com.br
MAIL_SEND_TOKEN=
EMAIL_NOME=Capiva Cloud
