# ---- Capiva Cloud — Backend (Bun) — imagem de deploy ----
# Diferenças em relação ao Dockerfile de desenvolvimento:
#   - git no build (a dependência @mateusseiboth/ts-decorators vem do GitHub);
#   - sem `|| true`: falha de install/generate quebra o build em vez de gerar
#     uma imagem silenciosamente quebrada;
#   - aplica as migrations antes de subir a API;
#   - roda como usuário sem privilégios.

# Estágio de dependências: o better-sqlite3 (adapter do Prisma para SQLite) compila
# código nativo no install e precisa de python3/make/g++. Essas ferramentas ficam só
# aqui; a imagem final recebe o node_modules pronto.
FROM oven/bun:1 AS deps
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bunfig.toml tsconfig.json ./
COPY prisma ./prisma
RUN bun install

FROM oven/bun:1 AS runtime
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# O prisma.config.ts exige DATABASE_URL mesmo para gerar o client; o generate não
# conecta no banco, então um endereço qualquer basta no build.
RUN DATABASE_URL="postgresql://build:build@localhost:5432/build" bunx prisma generate

# A imagem oven/bun já traz o usuário `bun` (uid 1000). Rodar como root daria ao
# processo — que executa comandos em clusters e nós via SSH — privilégio total
# dentro do container sem necessidade nenhuma.
RUN chown -R bun:bun /app
USER bun

ENV NODE_ENV=production
EXPOSE 3000 3001

# `/ready` valida a conexão com o banco; `/health` só diz que o processo subiu.
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3000/ready || exit 1

# NOTA: com mais de uma réplica do backend, rode `prisma migrate deploy` como
# passo único do rollout (job/init container) em vez de no CMD — o Prisma usa
# advisory lock, então réplicas concorrentes ficam serializadas esperando.
CMD ["sh", "-c", "bunx prisma migrate deploy && bun src/index.ts"]
