{
  "name": "@capiva/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI do Capiva Cloud (capiva): deploy, logs, variáveis e capiva.json pelo terminal.",
  "type": "module",
  "bin": {
    "capiva": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile src/index.ts --outfile dist/capiva",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "7.0.2"
  }
}
