# ---- Capiva Cloud — Frontend (build + nginx) — imagem de deploy ----
# O nginx serve o SPA e faz proxy de /api, /docs e /terminal para o backend,
# mantendo painel e API na MESMA ORIGEM. Isso é necessário porque o
# ORIGIN_WHITELIST de CORS do backend é fixo em localhost (src/http/server.ts)
# e o cookie de refresh usa sameSite=strict.
FROM oven/bun:1 AS build
WORKDIR /app

# Vazio => o cliente usa caminhos relativos (/api) na origem do painel.
ARG VITE_API_URL=""
ARG VITE_TERMINAL_WS_URL=""

COPY package.json ./
RUN bun install
COPY . .

# Vite lê variáveis em tempo de build: o .env do repo é substituído pelos ARGs.
RUN printf 'VITE_API_URL=%s\nVITE_TERMINAL_WS_URL=%s\n' "$VITE_API_URL" "$VITE_TERMINAL_WS_URL" > .env \
  && bun run build

FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.deploy.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
